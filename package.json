{
	"name": "toon-studio",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"check:all": "npm run check && npm run lint && npm run build",
		"lint": "eslint . --ext .ts,.svelte",
		"format": "prettier --write .",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:e2e": "playwright test",
		"tauri": "tauri dev",
		"tauri:build": "tauri build",
		"test:unit": "node --no-warnings --loader ./tests-unit/ts-loader.mjs --test tests-unit/*.test.ts",
		"bench": "npm run bench:picking",
		"build:wasm": "RUSTC_BOOTSTRAP=1 cargo build -p toon_engine_wasm --target wasm32-unknown-unknown -Zbuild-std=std,panic_abort --release && cp ../target/wasm32-unknown-unknown/release/toon_engine_wasm.wasm static/engine.wasm",
		"bench:picking": "node --no-warnings --loader ./tests-unit/ts-loader.mjs bench/picking.ts",
		"bench:wasm": "node --no-warnings --loader ./tests-unit/ts-loader.mjs bench/picking-wasm.ts",
		"bench:anim": "node --no-warnings --loader ./tests-unit/ts-loader.mjs bench/animation.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.43.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tauri-apps/cli": "^2.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"autoprefixer": "^10.4.19",
		"eslint": "^8.57.0",
		"eslint-plugin-svelte": "^2.36.0",
		"postcss": "^8.4.38",
		"prettier": "^3.2.0",
		"prettier-plugin-svelte": "^3.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^3.7.0",
		"tailwindcss": "^3.4.0",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0",
		"vite": "^5.2.0"
	}
}